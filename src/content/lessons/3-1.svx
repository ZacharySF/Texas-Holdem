<script>
  const exampleHand = '{A, B}';
  import AtTheTable from '../../features/learn/AtTheTable.svelte';
  import CombinationExamples from '../../features/learn/CombinationExamples.svelte';
  import Formula from '../../features/learn/Formula.svelte';
  import Hook from '../../features/learn/Hook.svelte';
  import Idea from '../../features/learn/Idea.svelte';
  import Orders from '../../features/learn/Orders.svelte';
  import PracticeSet from '../../features/learn/PracticeSet.svelte';
  import QuantCorner from '../../features/learn/QuantCorner.svelte';
  import Shortcut from '../../features/learn/Shortcut.svelte';
